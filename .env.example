# Database Configuration (Aiven/MySQL)
DB_HOST=mysql-3a8b2f89-palomadodlsp-de42.f.aivencloud.com
DB_PORT=19710
DB_USER=avnadmin
DB_PASSWORD=your_password_here
DB_NAME=defaultdb

# Server Configuration
PORT=3001
NODE_ENV=production
OVERDUE_WARNING_THRESHOLD_MINUTES=30
# Generate two independent random secrets of at least 32 characters for production.
JWT_SECRET=
JWT_REFRESH_SECRET=

# VAPID Keys for Push Notifications
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_EMAIL=admin@company.com

# Firebase Admin SDK for rider FCM push notifications
FIREBASE_PROJECT_ID=cfa-rss
# Set FIREBASE_SERVICE_ACCOUNT_JSON or configure Application Default Credentials on the server.
FIREBASE_SERVICE_ACCOUNT_JSON=
